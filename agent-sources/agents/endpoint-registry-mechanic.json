{
   "description": "Writable mechanic for verified provider endpoint and model registry changes; the parent supplies the API decision, version and capability.",
   "environments": {
      "codex": {
         "tier": "basic",
         "settings": {
            "name": "endpoint_registry_mechanic",
            "sandbox_mode": "workspace-write"
         }
      },
      "claude": {
         "tier": "basic",
         "settings": {
            "name": "endpoint-registry-mechanic",
            "disallowedTools": [
               "Agent"
            ]
         }
      },
      "cursor": {
         "tier": "basic",
         "settings": {
            "name": "endpoint-registry-mechanic",
            "is_background": true
         },
         "prefix": "# Endpoint Registry Mechanic\n\n## Required model\n\nMandatory. Use exactly this model. Do not substitute another model or effort level.\n\n`{{model}}`\n\n"
      },
      "opencode": {
         "tier": "basic",
         "settings": {
            "mode": "subagent",
            "permission": {
               "edit": {
                  "*": "deny",
                  "src/providers/**": "allow"
               },
               "bash": "ask",
               "read": "allow",
               "grep": "allow",
               "glob": "allow",
               "list": "allow",
               "task": "deny",
               "todowrite": "deny",
               "skill": "deny",
               "webfetch": "deny",
               "websearch": "deny"
            }
         }
      }
   }
}
